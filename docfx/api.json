{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "CargoHUB.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "reference"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "reference/**.yml",
          "index.md",
          "toc.yml"
        ]
      }
    ],
    "dest": "_site/api",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "CargoHUB API Reference",
      "_enableSearch": true
    }
  }
}
