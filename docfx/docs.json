{
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "toc.yml"
        ],
        "src": "../docs"
      }
    ],
    "dest": "_site/docs",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "CargoHUB Documentation",
      "_enableSearch": true
    }
  }
}
