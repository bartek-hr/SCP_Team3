<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- This project sits in the repo root, so by default it would include every file in the repo.
             The test project and everything that is not part of the API live in the solution's
             "Solution Items" folder instead (see CargoHUB.sln). -->
        <DefaultItemExcludes>$(DefaultItemExcludes);CargoHUB.Tests\**;docs\**;infra\**;legacy\**;.dockerignore;.editorconfig;.gitignore;Dockerfile;dotnet-tools.json</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
      <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Datasource\" />
      <Folder Include="Migrations\" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="swagger-ui\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <!-- Seed data for the migrations. Shown under Solution Items > legacy > data. -->
      <EmbeddedResource Include="legacy\data\*.json" LogicalName="CargoHUB.LegacyData.%(Filename)Json" Visible="false" />
    </ItemGroup>

</Project>
